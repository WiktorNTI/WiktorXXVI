.card
  h1 Admin Panel

  - if notice
    p.notice = notice

.card
  h2 All Users
  table
    thead
      tr
        th ID
        th Username
        th Role
        th Kingdom
        th Resources
        th Registered
        th Actions
    tbody
      - users.each do |u|
        tr
          td = u['id']
          td = u['username']
          td = u['role']
          td = u['kingdom_name'] || '—'
          td
            - if u['kingdom_id']
              form action="/admin/kingdom/#{u['kingdom_id']}/resources" method="post" style="display:flex;gap:4px;align-items:center;flex-wrap:wrap"
                label Wood
                input type="number" name="wood"  value="#{u['wood']}"  style="width:55px"
                label Stone
                input type="number" name="stone" value="#{u['stone']}" style="width:55px"
                label Food
                input type="number" name="food"  value="#{u['food']}"  style="width:55px"
                label Gold
                input type="number" name="gold"  value="#{u['gold']}"  style="width:55px"
                button type="submit" Save
            - else
              | —
          td = Time.at(u['created_at']).strftime('%Y-%m-%d')
          td style="display:flex;gap:4px"
            - if u['role'] != 'admin'
              form action="/admin/promote/#{u['id']}" method="post" style="display:inline"
                button type="submit" Promote to Admin
            - elsif u['id'] != current_user['id']
              form action="/admin/demote/#{u['id']}" method="post" style="display:inline"
                button type="submit" Demote
            - else
              | (you)&nbsp;
            - if u['id'] != current_user['id'] && u['role'] != 'admin'
              form action="/admin/delete/#{u['id']}" method="post" style="display:inline" onsubmit="return confirm('Delete #{u['username']}? This cannot be undone.')"
                button type="submit" style="color:red" Delete
